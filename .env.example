# APP_ENV=production enforces strict startup validation: missing secrets and the
# placeholder credentials below (local-dev-key, postgres:postgres) are rejected
# and the process refuses to boot. Leave as development for local runs.
APP_ENV=development

DISCORD_BOT_TOKEN=
API_KEY=

# Chat LLM. The docker-compose.yml file starts a local vLLM service for
# embeddings only; configure chat separately.
LLM_PROVIDER=ollama
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=http://vllm-embeddings:8000/v1
EMBEDDING_API_KEY=local-dev-key
EMBEDDING_DIMENSION=1024
# Keep BGE-M3 inputs as text. Do not use OpenAI/tiktoken IDs with vLLM.
EMBEDDING_OPENAI_COMPAT_RAW_TEXT=true
EMBEDDING_COLLECTION_VERSION=v1
# Reindex to a new name, validate it, then promote this variable.
KB_COLLECTION=knowledge_base

# Local vLLM embedding service used by docker-compose.yml.
VLLM_EMBEDDING_IMAGE=vllm/vllm-openai:latest
VLLM_EMBEDDING_PORT=8001
VLLM_GPU_MEMORY_UTILIZATION=0.70
HF_TOKEN=

EVAL_LLM_PROVIDER=
EVAL_LLM_MODEL=
EVAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
EVAL_LLM_API_KEY=local
EVAL_EMBEDDING_PROVIDER=
EVAL_EMBEDDING_MODEL=
EVAL_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EVAL_EMBEDDING_API_KEY=local

POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/postgres
REDIS_URL=redis://redis:6379/0

ENABLE_RAG=true
ENABLE_KNOWLEDGE_BASE=true
ENABLE_TOOL_CALLING=true
# Max model<->tool round trips for analytical (SQLite tool) queries.
TOOL_MAX_ROUNDS=3
HYBRID_RAG_ENABLED=true
# Local-first test profile: one retrieval pass, then citation/grounding checks.
SELF_RAG_ENABLED=false
RAG_FACTUAL_TEMPERATURE=0.1

# Retrieval candidate pools. `*_FUSED_TOP_K` is the pool after RRF and before
# Self-RAG relevance filtering; `RAG_TOP_K` / `KB_TOP_K` are final prompt caps.
RAG_TOP_K=5
RAG_VECTOR_TOP_K=20
RAG_BM25_TOP_K=20
RAG_FUSED_TOP_K=25
KB_TOP_K=7
KB_VECTOR_TOP_K=30
KB_BM25_TOP_K=40
KB_FUSED_TOP_K=40
SELF_RAG_MODE=batch
SELF_RAG_MAX_GRADE=20

RAG_RELEASE_SCOPE=public_v1
TRUSTED_KB_DOMAINS=pz,server_rules
RAG_EVIDENCE_MIN_SELF_RAG_SCORE=0.70

# Calibrated-confidence refusal thresholds (on a 0..1 confidence score)
#   confidence >= ANSWER  -> answer | >= CLARIFY -> ask to clarify | else abstain
RAG_ANSWER_MIN_CONFIDENCE=0.55
RAG_CLARIFY_MIN_CONFIDENCE=0.35
RAG_ANALYTICAL_CONFIDENCE_BONUS=0.05

# Post-generation groundedness gate: refuse answers not supported by sources.
RAG_GROUNDEDNESS_ENABLED=true
RAG_GROUNDEDNESS_MIN_SCORE=0.6
RAG_GROUNDEDNESS_TIMEOUT=20
# On provider/parse errors: fail open (answer). Consider false in production.
RAG_GROUNDEDNESS_FAIL_OPEN=true
# On judge TIMEOUT (the under-load case): fail closed (abstain) by default.
RAG_GROUNDEDNESS_TIMEOUT_FAIL_OPEN=false

# Show a chunk-level "Sources" footer ([n] -> file › heading › excerpt) to users.
RAG_SHOW_CITATIONS=true
